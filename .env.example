# ===== 项目 B（Group Chat 多 LLM 头脑风暴）环境变量模板 =====
# 复制为 .env 即可运行（实际值的 .env 已加进 .gitignore，防止提交）

# ===== LLM 提供方 =====
# 至少配置其中一个：OPENAI / DEEPSEEK / 本地 OLLAMA / MiniMax / Agnes

# OpenAI (主)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (限流时降级)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Anthropic Claude (可选)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (本地推理，无需 API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# MiniMax（OpenAI 兼容协议） — Token Plan: sk-cp-* prefix
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7-highspeed
MINIMAX_M3_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Agnes AI (OpenAI 兼容)
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ===== Stage 8-NPC-Love：per-NPC 自主 loop（ADR-0007 Option B）=====
# 启用 6 个 NPC 自主发言 loop（每个 NPC 自己判断要不要插话）。
# 默认 true；改 false 退回到老的 XiuzhenCronService。
GC_LOOPS_ENABLED=true
# MVP Candidate: one coordinator evaluates all six roles once per idle event.
# Legacy six per-NPC loops remain available only through the admin trigger.
GC_DAILY_BUDGET=40
# Batch semantic assessment hard timeout; failure defaults ordinary events to silence.
BEHAVIOR_ASSESS_TIMEOUT_SEC=15
# Total wall-clock deadline for one selected character's streamed response.
BEHAVIOR_GENERATION_TIMEOUT_SEC=90
# Hard cap after streaming; protects memory/UI even if a model ignores brevity prompts.
BEHAVIOR_MAX_RESPONSE_CHARS=600
# Optional; defaults to backend/data/behavior_decisions.sqlite
# BEHAVIOR_DECISION_DB_PATH=backend/data/behavior_decisions.sqlite
# 兼容别名（旧名，已 deprecated，新代码请改用 GC_LOOPS_ENABLED）
# 当 GC_LOOPS_ENABLED 没设、XZ_CRON_ENABLED=false 时会禁用 loop pool
# XZ_CRON_ENABLED=true

# ===== Stage 7：Letta v0.16.8 配置 =====
# LettA 服务地址（容器里默认 http://letta:8283；本机开发用 http://127.0.0.1:8283）
LETTA_BASE_URL=http://letta:8283
# Letta HTTP Basic 密码（username 固定为 letta；与 docker-compose.yml 里的 letta 服务 LETTA_SERVER_PASSWORD 保持一致）
LETTA_API_KEY=letta_dev_password
# 创建新 NPC agent 时使用的 Letta 句柄（与 `Letta /v1/models` 返回的 handle 对齐）
# 常见：openai/gpt-4o-mini / anthropic/claude-3-5-sonnet-20241022 / ollama/qwen2.5:1.5b
LETTA_LLM_MODEL=openai/gpt-4o-mini
# 与 docker-compose.yml 里 postgres 服务的 POSTGRES_PASSWORD 保持一致
LETTA_PG_PASSWORD=letta_dev_password
# 是否让 LangGraph leaves（make_agent_node + stream_dm_chat）走 Letta 而不是 per-role provider
#   - true (默认): Letta path；USE_MOCK_LLM 优先级更高（mock 永远走 MockChatModel）
#   - false:      走 4 个 minimax M3 + 2 个 agnes（legacy 路径）
USE_LETTA=true

# ===== 运行时开关 =====
# USE_MOCK_LLM=true 时强 mock 优先（任何 provider 都被压成 mock），用于离线 / 单元测试
USE_MOCK_LLM=false

# 后端
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Windows 启动器优先使用的端口：start-b.bat / start-b-launcher.bat 会先尝试
# 这两个值；被占用时按“向上 +100，再向下 -100”自动选择空闲端口，并把实际
# 端口记录到 backend/.groupchat-ports.env。
# GROUPCHAT_BACKEND_PORT=8000
# GROUPCHAT_FRONTEND_PORT=3000

# 前端
NEXT_PUBLIC_WS_URL=ws://localhost:8000
